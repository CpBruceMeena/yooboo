#!/usr/bin/env bash
#
# Pre-commit hook — protects master branch + runs tests on staged changes
#
# Install with: git config core.hooksPath .githooks
#
set -euo pipefail

# ─── Master branch protection — no direct commits ────────────────
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [ "$CURRENT_BRANCH" = "master" ]; then
  echo ""
  echo "   🚫 COMMIT BLOCKED: Direct commits to 'master' are not allowed."
  echo ""
  echo "   Create a feature branch instead:"
  echo "     git checkout -b feat/your-feature-name"
  echo "     git add <files>"
  echo "     git commit"
  echo ""
  echo "   Then merge your branch into master:"
  echo "     git checkout master"
  echo "     git merge feat/your-feature-name"
  echo ""
  echo "   To override (not recommended):"
  echo "     git commit --no-verify"
  echo ""
  exit 1
fi

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SMOKE_SCRIPT="$ROOT_DIR/scripts/smoke-test.mjs"
SERVER_DIR="$ROOT_DIR/server"
GAME_SERVER_PORT=3002
SMOKE_LOG="/tmp/pre-commit-smoke.log"
UNIT_LOG="/tmp/pre-commit-unit.log"
GAME_LOG="/tmp/pre-commit-game.log"

GAME_PID=""
server_was_running=false

# ─── Cleanup trap — prevents zombie server if hook is killed ─────
cleanup() {
  if [ "$server_was_running" = false ] && [ -n "$GAME_PID" ]; then
    kill "$GAME_PID" 2>/dev/null || true
    # Give it a moment to die gracefully, then force kill
    sleep 1
    kill -9 "$GAME_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

# ─── Check if relevant files are staged ──────────────────────────
relevant_files=$(git diff --cached --name-only -- \
  'server/' \
  'src/lib/game/' \
  'scripts/smoke-test.mjs' \
  'play-game.mjs' \
  'nginx.conf' \
  'vitest.config.ts' \
  'package.json' \
  2>/dev/null || true)

if [ -z "$relevant_files" ]; then
  echo "   ✓ No game/server/test config changes staged — skipping tests"
  exit 0
fi

echo ""
echo "   🧪 Running tests on staged changes..."
echo "   Files: $(echo "$relevant_files" | tr '\n' ' ')"
echo ""

# ─── Step 1: Run unit tests ──────────────────────────────────────
echo "   ── Step 1/2: Unit tests ───────────────────"
set +e
cd "$ROOT_DIR"
npx vitest run > "$UNIT_LOG" 2>&1
UNIT_EXIT=$?
set -e

if [ $UNIT_EXIT -ne 0 ]; then
  echo "   ✕ UNIT TESTS FAILED (exit code $UNIT_EXIT)"
  echo ""
  echo "   ── Test output ──────────────────────────────"
  cat "$UNIT_LOG"
  echo "   ──────────────────────────────────────────────"
  echo ""
  echo "   Commit blocked. Fix the failing tests or skip with:"
  echo "     git commit --no-verify"
  exit 1
else
  echo "   ✓ Unit tests passed"
fi

echo ""
echo "   ── Step 2/2: Smoke test ────────────────────"

# ─── Verify smoke test script exists ─────────────────────────────
if [ ! -f "$SMOKE_SCRIPT" ]; then
  echo "   ✕ Smoke test script not found at $SMOKE_SCRIPT"
  exit 1
fi

# ─── Check if game server is already running ─────────────────────
if lsof -ti :"$GAME_SERVER_PORT" 2>/dev/null | grep -q .; then
  echo "   ● Game server already running on port $GAME_SERVER_PORT"
  server_was_running=true
else
  echo "   ● Starting game server on port $GAME_SERVER_PORT..."
  cd "$SERVER_DIR"
  npx tsx index.ts > "$GAME_LOG" 2>&1 &
  GAME_PID=$!

  # Wait for server to be ready (up to 15s)
  waited=0
  while [ $waited -lt 15 ]; do
    if lsof -ti :"$GAME_SERVER_PORT" 2>/dev/null | grep -q .; then
      echo "   ● Game server started (PID $GAME_PID)"
      break
    fi
    sleep 1
    waited=$((waited + 1))
  done

  if [ $waited -ge 15 ]; then
    echo "   ✕ Game server failed to start within 15s"
    exit 1
  fi
fi

# ─── Run the smoke test ──────────────────────────────────────────
set +e
cd "$ROOT_DIR"
node "$SMOKE_SCRIPT" > "$SMOKE_LOG" 2>&1
EXIT_CODE=$?
set -e

# ─── Check results ───────────────────────────────────────────────
if [ $EXIT_CODE -ne 0 ]; then
  echo "   ✕ SMOKE TEST FAILED (exit code $EXIT_CODE)"
  echo ""
  echo "   ── Test output ──────────────────────────────"
  cat "$SMOKE_LOG"
  echo "   ──────────────────────────────────────────────"
  echo ""
  echo "   Commit blocked. Fix the failing tests or skip with:"
  echo "     git commit --no-verify"
  exit 1
else
  echo "   ✓ Smoke test passed!"
  exit 0
fi
